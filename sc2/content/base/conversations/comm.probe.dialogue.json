  "resource": "comm.probe.dialogue",
  "entry": "intro",
  "_migration": {
    "status": "graph_with_native_media",
    "remaining": "Only native resource/number-speech configuration and probe.coordinates rendering remain. Visits, reply selection, counters, bug state and victory/hostility live in this graph."
  },
  "phrases": [
    {
      "id": "WE_COME_IN_PEACE_1",
      "index": 0,
      "text": "WE COME IN PEACE.",
      "voice": "probe-000.ogg",
      "original_text_hash": 2529433850809842558
    },
    {
      "id": "WE_COME_IN_PEACE_2",
      "index": 1,
      "text": "WE BRING GREETINGS FROM A FRIENDLY SPECIES.",
      "voice": "probe-001.ogg",
      "original_text_hash": 13813062273563712625
    },
    {
      "id": "WE_COME_IN_PEACE_3",
      "index": 2,
      "text": "DO NOT FEAR. WE SHALL NOT HARM YOU.",
      "voice": "probe-002.ogg",
      "original_text_hash": 18143701534621010869
    },
    {
      "id": "WE_COME_IN_PEACE_4",
      "index": 3,
      "text": "THIS IS PROBE 2418-B, ON A PEACEFUL MISSION.",
      "voice": "probe-003.ogg",
      "original_text_hash": 4795260217853019226
    },
    {
      "id": "WE_COME_IN_PEACE_5",
      "index": 4,
      "text": "WE ARE NOT HOSTILE AND SEEK TO ESTABLISH FRIENDLY RELATIONS WITH YOUR SPECIES.",
      "voice": "probe-004.ogg",
      "original_text_hash": 16374079516371368324
    },
    {
      "id": "WE_COME_IN_PEACE_6",
      "index": 5,
      "text": "WE WISH TO LEARN MORE ABOUT YOU. PLEASE TRANSMIT DATA.",
      "voice": "probe-005.ogg",
      "original_text_hash": 13534816393970638896
    },
    {
      "id": "WE_COME_IN_PEACE_7",
      "index": 6,
      "text": "THIS PROBE IS NOT HOSTILE. DO NOT ATTACK.",
      "voice": "probe-006.ogg",
      "original_text_hash": 11528298656622341698
    },
    {
      "id": "WE_COME_IN_PEACE_8",
      "index": 7,
      "text": "WE COME IN PEACE.",
      "voice": "probe-007.ogg",
      "original_text_hash": 2529433850809842558
    },
    {
      "id": "threat_1",
      "index": 8,
      "text": "Submit or be destroyed!",
      "voice": null,
      "original_text_hash": 2833433118463500687
    },
    {
      "id": "threat_2",
      "index": 9,
      "text": "Attention alien probe. You must cease hostilities or face our wrath.",
      "voice": null,
      "original_text_hash": 15172468022765539138
    },
    {
      "id": "threat_3",
      "index": 10,
      "text": "Look here, probe! We have tried to be nice, but you keep shooting at us. So now, we fight!",
      "voice": null,
      "original_text_hash": 12544341132749264124
    },
    {
      "id": "threat_4",
      "index": 11,
      "text": "Prepare to be annihilated!",
      "voice": null,
      "original_text_hash": 18388956028419808528
    },
    {
      "id": "PROGRAMMED_TO_DEFEND_1",
      "index": 12,
      "text": "THIS PROBE IS PROGRAMMED TO DEFEND AGAINST HOSTILE BEHAVIOR.",
      "voice": "probe-008.ogg",
      "original_text_hash": 7474080483291730675
    },
    {
      "id": "PROGRAMMED_TO_DEFEND_2",
      "index": 13,
      "text": "SURVIVAL SYSTEM SUBROUTINE HAS BEEN ACTIVATED. WEAPONS ENGAGED.",
      "voice": "probe-009.ogg",
      "original_text_hash": 17334801944683408903
    },
    {
      "id": "PROGRAMMED_TO_DEFEND_3",
      "index": 14,
      "text": "ENACTING THIRD LAW.",
      "voice": "probe-010.ogg",
      "original_text_hash": 2421261791612015583
    },
    {
      "id": "PROGRAMMED_TO_DEFEND_4",
      "index": 15,
      "text": "DEFENSE SYSTEM HAS BEEN ENGAGED. HOSTILITIES COMMENCE.",
      "voice": "probe-011.ogg",
      "original_text_hash": 3588649258644571137
    },
    {
      "id": "something_wrong_1",
      "index": 16,
      "text": "What can you tell me about your species?",
      "voice": null,
      "original_text_hash": 2252048262868042230
    },
    {
      "id": "something_wrong_2",
      "index": 17,
      "text": "Is there something wrong? We seem to be miscommunicating.",
      "voice": null,
      "original_text_hash": 6372221477992170808
    },
    {
      "id": "something_wrong_3",
      "index": 18,
      "text": "Look, try to understand. We mean you no harm!",
      "voice": null,
      "original_text_hash": 14210283938873205944
    },
    {
      "id": "something_wrong_4",
      "index": 19,
      "text": "I am having a lot of trouble dealing with this. What's your problem?",
      "voice": null,
      "original_text_hash": 1959516596215696862
    },
    {
      "id": "NOMINAL_FUNCTION_1",
      "index": 20,
      "text": "REMOTE PROBE PROGRAMMED TO REPLICATE - RECORD DATA - CONTACT ALIEN SPECIES.",
      "voice": "probe-012.ogg",
      "original_text_hash": 3467913404913100587
    },
    {
      "id": "NOMINAL_FUNCTION_2",
      "index": 21,
      "text": "ACCORDING TO INTERNAL MONITORS THERE ARE NO MALFUNCTIONS.",
      "voice": "probe-013.ogg",
      "original_text_hash": 3865361490574867812
    },
    {
      "id": "NOMINAL_FUNCTION_3",
      "index": 22,
      "text": "I WILL INITIATE SYSTEMS CHECK LEVEL FOUR.\nCHECKING... CHECKING... CHECKING...\nSYSTEMS CHECK LEVEL FOUR REPORTS NO ABNORMALITIES OR MALFUNCTIONS.",
      "voice": "probe-014.ogg",
      "original_text_hash": 8659961122097255193
    },
    {
      "id": "NOMINAL_FUNCTION_4",
      "index": 23,
      "text": "ALL SYSTEMS REPORT NOMINAL FUNCTION.",
      "voice": "probe-015.ogg",
      "original_text_hash": 7005296127874561642
    },
    {
      "id": "we_are_us_1",
      "index": 24,
      "text": "We are from Earth, on a mission of peace.",
      "voice": null,
      "original_text_hash": 6688863747130275814
    },
    {
      "id": "we_are_us_2",
      "index": 25,
      "text": "We too come in peace, please believe us!",
      "voice": null,
      "original_text_hash": 7782322197602948767
    },
    {
      "id": "we_are_us_3",
      "index": 26,
      "text": "Hmmm.. maybe reverse psychology would work. Er... Die alien scum!",
      "voice": null,
      "original_text_hash": 18372058909637707506
    },
    {
      "id": "we_are_us_4",
      "index": 27,
      "text": "In case you don't already know, we are the nice people from Earth who you keep attacking.",
      "voice": null,
      "original_text_hash": 16126011261111989255
    },
    {
      "id": "THIS_IS_PROBE_1",
      "index": 28,
      "text": "THIS IS PROBE 2418-B. WE ARE ON A PEACEFUL MISSION OF EXPLORATION.",
      "voice": "probe-016.ogg",
      "original_text_hash": 7504018527728077968
    },
    {
      "id": "THIS_IS_PROBE_2",
      "index": 29,
      "text": "THIS IS PROBE 2418-B. WE SEEK TO MAKE FRIENDLY CONTACT WITH ALIEN LIFE FORMS.",
      "voice": "probe-017.ogg",
      "original_text_hash": 12525914398017208317
    },
    {
      "id": "THIS_IS_PROBE_3",
      "index": 30,
      "text": "THIS IS PROBE 2418-B. WE REPLICATE SO THAT WE MAY EXPAND THE SCOPE OF MISSION.",
      "voice": "probe-018.ogg",
      "original_text_hash": 6690714428005228430
    },
    {
      "id": "THIS_IS_PROBE_40",
      "index": 31,
      "text": "THIS IS PROBE 2418-B. COORDINATES ARE:",
      "voice": "probe-019.ogg",
      "original_text_hash": 15255253835301221008
    },
    {
      "id": "THIS_IS_PROBE_41",
      "index": 32,
      "text": ",",
      "voice": "probe-030.ogg",
      "original_text_hash": 12638122329369577547
    },
    {
      "id": "THIS_IS_PROBE_42",
      "index": 33,
      "text": ".",
      "voice": "probe-031.ogg",
      "original_text_hash": 12638124528392833969
    },
    {
      "id": "why_attack_1",
      "index": 34,
      "text": "We reach out our appendage in friendship. What is your response?",
      "voice": null,
      "original_text_hash": 11590395522689522731
    },
    {
      "id": "why_attack_2",
      "index": 35,
      "text": "Why do you attack us? We are not hostile to your life form.",
      "voice": null,
      "original_text_hash": 3328197381677459459
    },
    {
      "id": "why_attack_3",
      "index": 36,
      "text": "You misinterpret our intentions. Please do not attack!",
      "voice": null,
      "original_text_hash": 18420134659553587294
    },
    {
      "id": "why_attack_4",
      "index": 37,
      "text": "What's the use? I bet regardless what I say, you'll just attack.",
      "voice": null,
      "original_text_hash": 474628581064042478
    },
    {
      "id": "PEACEFUL_MISSION_1",
      "index": 38,
      "text": "MISSION DESCRIPTION FOLLOWS:\nTRAVERSE SPACE RECORDING DATA\nSEEK MATERIALS FOR REPLICATION\nREPLICATE TO EXPAND SCOPE OF MISSION\nCONTACT LIFE FORMS IN PEACEFUL MANNER\nAFTER TEN REPLICATIONS, RETURN TO POINT OF ORIGIN\nEND OF MISSION DESCRIPTION.",
      "voice": "probe-020.ogg",
      "original_text_hash": 2182905000735307088
    },
    {
      "id": "PEACEFUL_MISSION_2",
      "index": 39,
      "text": "BEHAVIOR FOLLOWS DICTATED PRIORITIES\nREPLICATION\nDATA GATHERING\nCONTACTING ALIEN LIFE FORMS IN PEACEFUL MANNER.",
      "voice": "probe-021.ogg",
      "original_text_hash": 13622362901594780771
    },
    {
      "id": "PEACEFUL_MISSION_3",
      "index": 40,
      "text": "REPLICATION STATUS\nEIGHT REPLICATIONS\nNEXT REPLICATION 85 PERCENT COMPLETE\nESTIMATED REPLICATIONS SINCE DEPARTURE FROM POINT OF ORIGIN\n583 REPLICATIONS.\nESTIMATED REPLICATIONS PROJECTED ONE YEAR FROM THIS DATE\n14,784 REPLICATIONS.\nESTIMATED REPLICATIONS PROJECTED FIVE YEARS FROM THIS DATE\n45,786,412 REPLICATIONS.",
      "voice": "probe-022.ogg",
      "original_text_hash": 4222069888567782306
    },
    {
      "id": "PEACEFUL_MISSION_4",
      "index": 41,
      "text": "PRIORITIES SET AT POINT OF ORIGIN.\nBEHAVIOR FOLLOWS DICTATED PRIORITIES",
      "voice": "probe-023.ogg",
      "original_text_hash": 18049947787455645881
    },
    {
      "id": "bye_1",
      "index": 42,
      "text": "Goodbye probe.",
      "voice": null,
      "original_text_hash": 16892129398789446428
    },
    {
      "id": "bye_2",
      "index": 43,
      "text": "Goodbye probe.",
      "voice": null,
      "original_text_hash": 16892129398789446428
    },
    {
      "id": "bye_3",
      "index": 44,
      "text": "Goodbye and good riddance.",
      "voice": null,
      "original_text_hash": 12951862422315364218
    },
    {
      "id": "bye_4",
      "index": 45,
      "text": "Are you going to let me leave in peace this time?",
      "voice": null,
      "original_text_hash": 6219603660983061616
    },
    {
      "id": "GOODBYE_1",
      "index": 46,
      "text": "ENDING ALIEN CONTACT SUBROUTINE.",
      "voice": "probe-024.ogg",
      "original_text_hash": 3274913455838094685
    },
    {
      "id": "GOODBYE_2",
      "index": 47,
      "text": "ENDING ALIEN CONTACT SUBROUTINE.",
      "voice": "probe-025.ogg",
      "original_text_hash": 3274913455838094685
    },
    {
      "id": "GOODBYE_3",
      "index": 48,
      "text": "ENDING ALIEN CONTACT SUBROUTINE.",
      "voice": "probe-026.ogg",
      "original_text_hash": 3274913455838094685
    },
    {
      "id": "GOODBYE_4",
      "index": 49,
      "text": "ENDING ALIEN CONTACT SUBROUTINE.",
      "voice": "probe-027.ogg",
      "original_text_hash": 3274913455838094685
    },
    {
      "id": "HOSTILE",
      "index": 50,
      "text": "PRIORITY OVER-RIDE. NEW BEHAVIOR DICTATED.\nMUST BREAK TARGET INTO COMPONENT MATERIALS.",
      "voice": "probe-028.ogg",
      "original_text_hash": 17916614345425253848
    },
    {
      "id": "DESTRUCT_SEQUENCE",
      "index": 51,
      "text": "ENGAGING SELF-DESTRUCTION CIRCUITRY.",
      "voice": "probe-029.ogg",
      "original_text_hash": 6391048667266402932
    },
    {
      "id": "destruct_code",
      "index": 52,
      "text": "Transmit destruct sequence!",
      "voice": null,
      "original_text_hash": 10088071926682105177
    },
    {
      "id": "COORD_PLUS",
      "index": 53,
      "text": "+",
      "voice": "probe-032.ogg",
      "original_text_hash": 12638127826927718602
    },
    {
