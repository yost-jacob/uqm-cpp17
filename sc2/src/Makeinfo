uqm_SUBDIRS="libs res uqm"
uqm_CXXFILES="game_configuration.cpp"
uqm_CFILES="options.c port.c uqm.c"
uqm_HFILES="game_configuration.h game_configuration.hpp config.h endian_uqm.h options.h port.h types.h uqmversion.h"

if [ "$uqm_HAVE_GETOPT_LONG" = 0 ]; then
	uqm_SUBDIRS="$uqm_SUBDIRS getopt"
fi

case "$HOST_SYSTEM" in
	Darwin)
		uqm_SUBDIRS="$uqm_SUBDIRS darwin"
		;;
	MSVC)
		uqm_HFILES="game_configuration.h game_configuration.hpp $uqm_HFILES config_vc6.h"
		;;
esac

if [ "$uqm_HAVE_REGEX" = 0 ]; then
	uqm_SUBDIRS="$uqm_SUBDIRS regex"
fi

